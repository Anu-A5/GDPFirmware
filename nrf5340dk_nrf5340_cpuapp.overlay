//need address of ppg and mic i2c target address, 01a and 02a used as placeholders

&i2c1 {
    ppg: ppg@01a{
        compatible ="i2c-device";
        reg        = < 0x1a >;
        label      = "PPG";
    };

    mic: mic@02a{
        compatible = "i2c-device";
        reg        = < 0x2a >;
        label      = "MIC";
    };
};